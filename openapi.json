{
  "openapi": "3.1.0",
  "info": {
    "title": "API Data - Détecteur de tendances (Givaudan)",
    "description": "Score de durabilité des tendances émergentes (saveurs, parfumerie, actifs beauté, boissons), calculé à partir de Google Trends, Wikipedia, Google News et de signaux manuels (TikTok, Pinterest). Les données sont recalculées par `collect_trends.py`.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "système"
        ],
        "summary": "Health",
        "description": "Vérifie que les données sont chargées.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/trends": {
      "get": {
        "tags": [
          "tendances"
        ],
        "summary": "List Trends",
        "description": "Liste des tendances, triées par score décroissant.",
        "operationId": "list_trends_trends_get",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrer par univers",
              "examples": [
                "Beauté et actifs"
              ],
              "title": "Category"
            },
            "description": "Filtrer par univers"
          },
          {
            "name": "stage",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "émergente",
                    "croissance",
                    "plateau",
                    "déclin",
                    "inconnu"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrer par stade",
              "title": "Stage"
            },
            "description": "Filtrer par stade"
          },
          {
            "name": "min_score",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 0,
              "description": "Score minimum",
              "default": 0,
              "title": "Min Score"
            },
            "description": "Score minimum"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TrendSummary"
                  },
                  "title": "Response List Trends Trends Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/trends/{trend_id}": {
      "get": {
        "tags": [
          "tendances"
        ],
        "summary": "Get Trend",
        "description": "Détail d'une tendance, avec les sous-scores qui expliquent le score.",
        "operationId": "get_trend_trends__trend_id__get",
        "parameters": [
          {
            "name": "trend_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Trend Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrendSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/trends/{trend_id}/timeseries": {
      "get": {
        "tags": [
          "tendances"
        ],
        "summary": "Get Timeseries",
        "description": "Courbes mois par mois (pour les graphiques), une série par source.",
        "operationId": "get_timeseries_trends__trend_id__timeseries_get",
        "parameters": [
          {
            "name": "trend_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Trend Id"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "examples": [
                "google_trends"
              ],
              "title": "Source"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TimeseriesPoint"
                  },
                  "title": "Response Get Timeseries Trends  Trend Id  Timeseries Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/trends/score": {
      "post": {
        "tags": [
          "tendances"
        ],
        "summary": "Score",
        "description": "Score d'une tendance à partir de son nom : c'est l'appel principal pour l'application.\n\nSi la tendance n'a jamais été collectée et que `auto_collect` vaut true, elle est collectée\nà la demande (Google Trends en cache dans google_trends/), puis ajoutée aux résultats.",
        "operationId": "score_trends_score_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/catalogue": {
      "get": {
        "tags": [
          "catalogue (simulé)"
        ],
        "summary": "Get Catalogue",
        "description": "Catalogue Givaudan SIMULÉ (environ 25 arômes) pour le prototype.",
        "operationId": "get_catalogue_catalogue_get",
        "parameters": [
          {
            "name": "famille",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Famille"
            }
          },
          {
            "name": "au_catalogue",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Au Catalogue"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Arome"
                  },
                  "title": "Response Get Catalogue Catalogue Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/trends/{trend_id}/aromes": {
      "get": {
        "tags": [
          "catalogue (simulé)"
        ],
        "summary": "Get Aromes",
        "description": "Arôme Givaudan à utiliser pour une tendance, et alternatives si la matière est sous tension.",
        "operationId": "get_aromes_trends__trend_id__aromes_get",
        "parameters": [
          {
            "name": "trend_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Trend Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AromesTendance"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Arome": {
        "properties": {
          "arome_id": {
            "type": "string",
            "title": "Arome Id",
            "examples": [
              "sudachi"
            ]
          },
          "nom": {
            "type": "string",
            "title": "Nom",
            "examples": [
              "Arôme sudachi"
            ]
          },
          "famille": {
            "type": "string",
            "title": "Famille",
            "examples": [
              "agrumes"
            ]
          },
          "univers": {
            "type": "string",
            "title": "Univers"
          },
          "tendances": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tendances",
            "description": "Tendances auxquelles l'arôme répond"
          },
          "au_catalogue": {
            "type": "boolean",
            "title": "Au Catalogue",
            "description": "true : arôme existant (délai 1 mois) ; false : à développer (6 mois)"
          },
          "prix_kg_eur": {
            "type": "number",
            "title": "Prix Kg Eur"
          },
          "disponibilite": {
            "type": "string",
            "enum": [
              "élevée",
              "moyenne",
              "faible"
            ],
            "title": "Disponibilite"
          },
          "delai_mois": {
            "type": "integer",
            "title": "Delai Mois"
          },
          "origine_matiere": {
            "type": "string",
            "title": "Origine Matiere"
          },
          "saisonnalite": {
            "type": "string",
            "title": "Saisonnalite"
          },
          "risque_recolte": {
            "type": "string",
            "enum": [
              "faible",
              "moyen",
              "élevé"
            ],
            "title": "Risque Recolte"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "simule": {
            "type": "boolean",
            "title": "Simule",
            "description": "Toujours true : le catalogue Givaudan est simulé pour le prototype",
            "default": true
          },
          "score_faisabilite": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Score Faisabilite",
            "description": "50 % disponibilité, 30 % au catalogue, 20 % élan de la tendance liée"
          }
        },
        "type": "object",
        "required": [
          "arome_id",
          "nom",
          "famille",
          "univers",
          "tendances",
          "au_catalogue",
          "prix_kg_eur",
          "disponibilite",
          "delai_mois",
          "origine_matiere",
          "saisonnalite",
          "risque_recolte"
        ],
        "title": "Arome"
      },
      "AromesTendance": {
        "properties": {
          "trend_id": {
            "type": "string",
            "title": "Trend Id"
          },
          "arome_principal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Arome"
              },
              {
                "type": "null"
              }
            ]
          },
          "aromes_lies": {
            "items": {
              "$ref": "#/components/schemas/Arome"
            },
            "type": "array",
            "title": "Aromes Lies"
          },
          "alternatives": {
            "items": {
              "$ref": "#/components/schemas/Arome"
            },
            "type": "array",
            "title": "Alternatives",
            "description": "Même famille aromatique, classées par faisabilité"
          },
          "matiere_sous_tension": {
            "type": "boolean",
            "title": "Matiere Sous Tension",
            "description": "true si la matière principale est rare ou à risque de récolte"
          },
          "ia_recommandation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ia Recommandation"
          }
        },
        "type": "object",
        "required": [
          "trend_id",
          "arome_principal",
          "aromes_lies",
          "alternatives",
          "matiere_sous_tension"
        ],
        "title": "AromesTendance"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "examples": [
              "ok"
            ]
          },
          "trends": {
            "type": "integer",
            "title": "Trends",
            "description": "Nombre de tendances chargées",
            "examples": [
              20
            ]
          },
          "collected_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Collected At",
            "examples": [
              "2026-11-12"
            ]
          }
        },
        "type": "object",
        "required": [
          "status",
          "trends"
        ],
        "title": "Health"
      },
      "ScoreRequest": {
        "properties": {
          "trend_name": {
            "type": "string",
            "minLength": 1,
            "title": "Trend Name",
            "description": "Nom de la tendance (casse et accents ignorés)",
            "examples": [
              "peptide serum"
            ]
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category",
            "description": "Univers Givaudan, utilisé si la tendance est nouvelle",
            "examples": [
              "Beauté et actifs"
            ]
          },
          "auto_collect": {
            "type": "boolean",
            "title": "Auto Collect",
            "description": "Si la tendance est inconnue, la collecter automatiquement (Google Trends, Wikipedia, Google News). Prend de 10 s à 1 min.",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "trend_name"
        ],
        "title": "ScoreRequest"
      },
      "ScoreResponse": {
        "properties": {
          "trend_name": {
            "type": "string",
            "title": "Trend Name",
            "examples": [
              "peptide serum"
            ]
          },
          "score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score",
            "examples": [
              64
            ]
          },
          "growth_5y": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Growth 5Y",
            "examples": [
              1173
            ]
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "Sources utilisées, séparées par des points-virgules",
            "examples": [
              "Google Trends; Google News"
            ]
          },
          "recommendation": {
            "type": "string",
            "title": "Recommendation",
            "examples": [
              "À surveiller : signal prometteur, à confirmer avec d'autres sources"
            ]
          },
          "stage": {
            "type": "string",
            "enum": [
              "émergente",
              "croissance",
              "plateau",
              "déclin",
              "inconnu"
            ],
            "title": "Stage",
            "examples": [
              "plateau"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "basse",
              "moyenne",
              "élevée"
            ],
            "title": "Confidence",
            "examples": [
              "moyenne"
            ]
          },
          "tiktok_authenticity": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tiktok Authenticity",
            "description": "Voir TrendSummary",
            "examples": [
              78
            ]
          },
          "tiktok_verdict": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tiktok Verdict",
            "examples": [
              "engouement sincère avec intention d'achat"
            ]
          }
        },
        "type": "object",
        "required": [
          "trend_name",
          "score",
          "source",
          "recommendation",
          "stage",
          "confidence"
        ],
        "title": "ScoreResponse"
      },
      "TimeseriesPoint": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source",
            "examples": [
              "Google Trends"
            ]
          },
          "period": {
            "type": "string",
            "title": "Period",
            "description": "Mois (AAAA-MM-JJ)",
            "examples": [
              "2026-10-01"
            ]
          },
          "value": {
            "type": "number",
            "title": "Value",
            "description": "Valeur brute de la source",
            "examples": [
              61.0
            ]
          },
          "value_norm": {
            "type": "number",
            "title": "Value Norm",
            "description": "Valeur ramenée à 100 pour le pic de la source",
            "examples": [
              61.0
            ]
          }
        },
        "type": "object",
        "required": [
          "source",
          "period",
          "value",
          "value_norm"
        ],
        "title": "TimeseriesPoint"
      },
      "TrendSummary": {
        "properties": {
          "trend_id": {
            "type": "string",
            "title": "Trend Id",
            "description": "Identifiant stable (sans accents ni espaces)",
            "examples": [
              "peptide_serum"
            ]
          },
          "trend_name": {
            "type": "string",
            "title": "Trend Name",
            "examples": [
              "peptide serum"
            ]
          },
          "category": {
            "type": "string",
            "title": "Category",
            "description": "Univers Givaudan",
            "examples": [
              "Beauté et actifs"
            ]
          },
          "score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score",
            "description": "Score de durabilité : 40 % évolution, 30 % récurrence, 30 % diffusion",
            "examples": [
              64
            ]
          },
          "growth_5y": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Growth 5Y",
            "description": "Croissance en % entre le début et la fin de la série (5 ans)",
            "examples": [
              1173
            ]
          },
          "growth_12m": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Growth 12M",
            "description": "Croissance moyenne en % sur 12 mois, toutes sources",
            "examples": [
              41
            ]
          },
          "evolution_score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Evolution Score",
            "description": "Sous-score : croissance 12 mois et 5 ans",
            "examples": [
              48
            ]
          },
          "recurrence_score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Recurrence Score",
            "description": "Sous-score : durée passée au-dessus de 40 % du pic",
            "examples": [
              64
            ]
          },
          "diffusion_score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Diffusion Score",
            "description": "Sous-score : sources en croissance et nombre de médias",
            "examples": [
              87
            ]
          },
          "early_signal_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Early Signal Score",
            "description": "Niveau récent des signaux précoces (TikTok, Pinterest), si disponibles",
            "examples": [
              72
            ]
          },
          "stage": {
            "type": "string",
            "enum": [
              "émergente",
              "croissance",
              "plateau",
              "déclin",
              "inconnu"
            ],
            "title": "Stage",
            "description": "Stade du cycle de vie",
            "examples": [
              "plateau"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "basse",
              "moyenne",
              "élevée"
            ],
            "title": "Confidence",
            "description": "Fiabilité selon le nombre de sources",
            "examples": [
              "moyenne"
            ]
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources",
            "description": "Sources utilisées",
            "examples": [
              [
                "Google Trends",
                "Google News"
              ]
            ]
          },
          "n_sources": {
            "type": "integer",
            "title": "N Sources",
            "examples": [
              2
            ]
          },
          "news_articles_30d": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "News Articles 30D",
            "description": "Articles de presse sur 30 jours",
            "examples": [
              10
            ]
          },
          "news_publishers_30d": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "News Publishers 30D",
            "description": "Médias distincts sur 30 jours",
            "examples": [
              10
            ]
          },
          "news_articles_365d": {
            "anyOf": [
              {
